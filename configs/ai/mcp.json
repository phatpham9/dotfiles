{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "openviking": {
      "type": "http",
      "url": "http://127.0.0.1:1933/mcp"
    },
    "huggingface": {
      "type": "http",
      "url": "https://huggingface.co/mcp?login"
    },
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": ["markitdown-mcp"]
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "arxiv-mcp-server": {
      "type": "stdio",
      "command": "uv",
      "args": ["tool", "run", "arxiv-mcp-server", "--storage-path", "${HOME}/.cache/arxiv-mcp-server"]
    },
    "bgpt": {
      "type": "sse",
      "url": "https://bgpt.pro/mcp/sse"
    }
  }
}
